# A hosted PostgreSQL connection string is required for persistent accounts, history, favorites, and playlists.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/devilbeats
# Generate a long random value before deploying.
SECRET_KEY=replace-with-a-long-random-secret
# Your deployed frontend URL, plus any local origins you want to keep during development.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
